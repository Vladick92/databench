# Copy to .env.

# --- Model ---
# MODEL_PROVIDER picks a preset (base URL + a default model): local | groq | gemini | mistral | openrouter.
# See docs/switching-model-providers.md. Provider API keys come from ../model_service/.env, not
# from here. To override the preset's model/URL/key explicitly, set MODEL_BASE_URL/MODEL_NAME/
# MODEL_API_KEY directly - they always win over the preset.
# `local` needs the model server running first: ./run_local_model.sh (Qwen2.5-Coder-7B Q2_K).
MODEL_PROVIDER=local

# Optional fallback: comma-separated providers, tried in order when the current one can't answer a
# request (rate limit, outage, server not running). Each uses its preset's default model and its own
# key from ../model_service/.env. Empty = no fallback. Example: MODEL_FALLBACK_PROVIDERS=openrouter
MODEL_FALLBACK_PROVIDERS=

# --- Data sources ---
DATA_DIR=./data
# Rows one query call retrieves; the statistician charts all of them.
MAX_ROWS_RETURNED=1000
# A result with more rows than this is charted by the statistician and summarized (not listed)
# by the data agent; up to this many rows the data agent shows the whole result as a table.
CHART_MIN_ROWS=15

# Leave POSTGRES_DSN unset to run with file sources only.
# Point it at a READ-ONLY role (see docs/PLAN.md for the CREATE ROLE snippet) - the agent
# should not be able to write even if validation had a gap.
# POSTGRES_DSN=postgresql://databench_ro:<password>@localhost:5432/therapist_db
POSTGRES_SCHEMA=public
POSTGRES_STATEMENT_TIMEOUT_MS=5000

# --- Streamlit UI -> FastAPI backend ---
BACKEND_URL=http://127.0.0.1:8000
