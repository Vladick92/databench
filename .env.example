# Copy to .env.

# --- Model ---
# MODEL_PROVIDER picks a preset (base URL + a small default model): local | groq | gemini | mistral.
# See docs/switching-model-providers.md. Provider API keys come from ../model_service/.env, not
# from here. To override the preset's model/URL/key explicitly, set MODEL_BASE_URL/MODEL_NAME/
# MODEL_API_KEY directly - they always win over the preset.
MODEL_PROVIDER=local

# --- Data sources ---
DATA_DIR=./data
MAX_ROWS_RETURNED=50

# Leave POSTGRES_DSN unset to run with file sources only.
# Point it at a READ-ONLY role (see docs/PLAN.md for the CREATE ROLE snippet) - the agent
# should not be able to write even if validation had a gap.
# POSTGRES_DSN=postgresql://databench_ro:<password>@localhost:5432/therapist_db
POSTGRES_SCHEMA=public
POSTGRES_STATEMENT_TIMEOUT_MS=5000

# --- Streamlit UI -> FastAPI backend ---
BACKEND_URL=http://127.0.0.1:8000
