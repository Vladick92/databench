# Copy to .env.

# --- Model ---
# MODEL_PROVIDER picks a preset (base URL + a default model): local | groq | gemini | mistral | openrouter.
# See docs/switching-model-providers.md. Provider API keys come from ../model_service/.env, not
# from here. To override the preset's model/URL/key explicitly, set MODEL_BASE_URL/MODEL_NAME/
# MODEL_API_KEY directly - they always win over the preset.
# Same model as in Azure (terraform/variables.tf `model_name`): GPT-6 Luna through OpenRouter. It is a
# paid model (not :free), so it spends the OpenRouter credit.
# NOT the same thing as APP_ENV below: a provider called `local` is the llama-server model, which
# needs ./run_local_model.sh running first (Qwen2.5-Coder-7B Q2_K) and can't drive the tools.
MODEL_PROVIDER=openrouter
# The model of the provider above. <PROVIDER>_MODEL (OPENROUTER_MODEL, GROQ_MODEL, ...) only applies while
# that provider is the primary one, so changing MODEL_PROVIDER alone can't send it another provider's
# model id. MODEL_NAME also works but wins for any provider: leave it unset unless you mean that.
# An unknown MODEL_PROVIDER stops the backend at startup.
OPENROUTER_MODEL=openai/gpt-6-luna

# Optional fallback: comma-separated providers, tried in order when the current one can't answer a
# request (rate limit, outage, server not running). Each uses its preset's default model and its own
# key from ../model_service/.env. Empty = no fallback. Example: MODEL_FALLBACK_PROVIDERS=openrouter
MODEL_FALLBACK_PROVIDERS=

# --- Data sources ---
DATA_DIR=./data
# These four behaviour settings also exist in Azure: Terraform variables max_rows_returned,
# chart_min_rows, max_upload_mb and auth_token_hours (further down), same defaults as here. Change both,
# or a local run and the deployed app behave differently.
# Rows one query call retrieves; the statistician charts all of them.
MAX_ROWS_RETURNED=1000
# A result with more rows than this is charted by the statistician and summarized (not listed)
# by the data agent; up to this many rows the data agent shows the whole result as a table.
CHART_MIN_ROWS=15

# Leave POSTGRES_DSN unset to run with file sources only. Local run mode only in practice: with
# APP_ENV=azure a DSN that points at localhost / a socket is refused at startup (the Web App can't reach it).
# Point it at a READ-ONLY role (see docs/PLAN.md for the CREATE ROLE snippet) - the agent
# should not be able to write even if validation had a gap.
# POSTGRES_DSN=postgresql://databench_ro:<password>@localhost:5432/therapist_db
POSTGRES_SCHEMA=public
POSTGRES_STATEMENT_TIMEOUT_MS=5000

# --- Run mode: where users, chats and files live ---
# local (default): users/chats/messages in a SQLite file in ./var (VAR_DIR), each user's tables and
#   charts in a folder under ../users (USERS_DIR; that folder is outside this repo), the login key in ./var.
# azure: Cosmos DB + one Blob container per user + AUTH_SECRET. Terraform sets APP_ENV=azure and the
#   settings that go with it (COSMOS_ENDPOINT, COSMOS_DATABASE, AZURE_STORAGE_ACCOUNT_NAME, AUTH_SECRET)
#   on the backend Web App; you don't set them here. Mixing is refused at startup: azure without
#   them, or local with COSMOS_ENDPOINT / AZURE_STORAGE_ACCOUNT_NAME present.
APP_ENV=local
# USERS_DIR=../users
# Same names as the Terraform variables auth_token_hours / max_upload_mb: keep them equal.
AUTH_TOKEN_HOURS=12
MAX_UPLOAD_MB=25

# --- Ports (docker compose; with host networking these are the machine's ports) ---
# The native app and `docker compose` use the same defaults, and project 01's Streamlit uses 8501:
# run one of them, or move this stack here. llama-server (8080) is set by run_local_model.sh.
BACKEND_PORT=8000
UI_PORT=8501

# --- Streamlit UI -> FastAPI backend (native runs; compose derives it from BACKEND_PORT) ---
BACKEND_URL=http://127.0.0.1:8000
