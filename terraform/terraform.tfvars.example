# Copy to terraform.tfvars (gitignored) and fill in, or pass via -var/TF_VAR_*.
# groq_api_key should NOT go in this file if you ever intend to commit it - use
# TF_VAR_groq_api_key instead (see terraform/README.md).

location            = "polandcentral"
environment         = "dev"
image_tag           = "v1"
budget_alert_email  = "" # set this before applying - see docs/PLAN.md cost discipline
budget_amount       = 15
