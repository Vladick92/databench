terraform {
  required_version = ">= 1.6"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

provider "azurerm" {
  features {}
  # Subscription comes from `az login` (ARM_SUBSCRIPTION_ID env var or var.subscription_id).
  subscription_id = var.subscription_id
}
